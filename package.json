{
  "name": "stepkeep",
  "version": "0.1.0",
  "description": "把长教程拆成可逐步执行的卡片，卡住时就地追问，并记住每个任务做到哪一步。",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p . && vite build",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "e2e": "node scripts/e2e.mjs",
    "try": "node scripts/try-decompose.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/COLDDCC/Stepkeep.git"
  },
  "bugs": {
    "url": "https://github.com/COLDDCC/Stepkeep/issues"
  },
  "homepage": "https://github.com/COLDDCC/Stepkeep#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "dompurify": "^3.4.15",
    "idb": "^8.0.3",
    "marked": "^18.0.14",
    "preact": "^10.29.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/chrome": "^0.3.0",
    "@types/node": "^26.6.2",
    "fake-indexeddb": "^6.2.5",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "private": true,
  "type": "module"
}
